# Copy to .env in the Codespace (the Codespace builds .env from the repo's own
# .env.example). Never commit .env: keys belong in Codespaces secrets.
LLM_MODEL=groq/openai/gpt-oss-20b
# Backup model, if Groq is down or the daily free requests are used up:
# LLM_MODEL=gemini/gemini-3.5-flash-lite

# Keys are read from the environment (Codespaces secrets). Do not paste them here.
# GROQ_API_KEY=
# GEMINI_API_KEY=
